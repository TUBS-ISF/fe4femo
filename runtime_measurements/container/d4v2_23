Bootstrap: docker
From:ubuntu:24.04
Stage: builder

%post
    apt-get update && apt-get -y install git libgmp3-dev zlib1g-dev cmake gcc build-essential manpages-dev software-properties-common libboost-all-dev ninja-build wget
    add-apt-repository ppa:ubuntu-toolchain-r/test
    apt-get update && apt-get -y install gcc-11 g++-11
    rm /usr/bin/gcc && rm /usr/bin/g++
    ln -s /usr/bin/gcc-11 /usr/bin/gcc && ln -s /usr/bin/g++-11 /usr/bin/g++

    mkdir /app/
    cd /app

%post
    git clone https://github.com/crillab/d4v2.git
    cd /app/d4v2
    git checkout cc730adbbdb59b6e05776fbf2939b2aba53f2b80
    cd /app/d4v2/3rdParty/
    wget https://faculty.cc.gatech.edu/~umit/PaToH/patoh-Linux-x86_64-2019-10-01.tar.gz
    rm -rf patoh/*
    tar -xf patoh-Linux-x86_64-2019-10-01.tar.gz
    mv build/Linux-x86_64/* patoh/
    cd /app/d4v2
    ./build.sh

Bootstrap: docker
From: ubuntu:24.04
Stage: final

%post
    apt-get update && apt-get -y install libgmp3-dev bc coreutils bash
    mkdir /in/
    mkdir /out/

    cd /app

%files from builder
    /app/d4v2/build/d4 /app/

%files
    runscripts/measure.sh /app/measure.sh
    runscripts/d4v2_23.sh /app/start.sh

%post
    chmod +x measure.sh
    chmod +x start.sh

%runscript
    echo "Test"
    exec /bin/bash /app/measure.sh "$@"
