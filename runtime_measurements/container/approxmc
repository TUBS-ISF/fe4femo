Bootstrap: docker
From: alpine:3.20.3
Stage: builder

%post
    apk add --no-cache git build-base bash wget
    cd /app
    wget http://www.msoos.org/private/approxmc-17-oct-2024-linux64

From: alpine:3.20.3
Stage: container

%post
    apk add --no-cache bash bc coreutils
    mkdir /in/
    mkdir /out/

    cd /app

%files from builder
    /app/approxmc-17-oct-2024-linux64 /app/approxmc
%post
    chmod 0777 approxmc

%files from container
    runscripts/measure.sh /app/
    runscripts/approxmc.sh /app/start.sh

%post
    chmod 0777 measure.sh
    chmod 0777 start.sh
    cd /app

%runscript ["/app/measure.sh"]
