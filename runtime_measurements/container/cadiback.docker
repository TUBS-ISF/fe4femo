Bootstrap: docker
From: alpine:3.20.3
%post apk add --no-cache git build-base bash

--cwd /app

%post chmod 0644 /etc/passwd
%post git clone https://github.com/arminbiere/cadical.git
--cwd /app/cadical
%post ./configure && make

--cwd /app/
%post git clone https://github.com/arminbiere/cadiback.git
--cwd /app/cadiback
%post ./configure && make

From: alpine:3.20.3

%post apk add --no-cache bash build-base bc coreutils

%post mkdir /in/
%post mkdir /out/

--cwd /app

%files --from=builder /app/cadiback/cadiback /app/

%files runscripts/measure.sh /app/
%post chmod 0777 measure.sh

%files runscripts/cadiback.sh /app/start.sh
%post chmod 0777 start.sh

%runscript ["/app/measure.sh"]
