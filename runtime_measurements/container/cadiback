Bootstrap: docker
From: alpine:3.20.3
Stage: builder

%post
    apk add --no-cache git build-base bash
    cd /app
    chmod 0644 /etc/passwd
    git clone https://github.com/arminbiere/cadical.git
    cd /app/cadical
    ./configure && make
    cd /app/
    git clone https://github.com/arminbiere/cadiback.git
    cd /app/cadiback
    ./configure && make

From: alpine:3.20.3
Stage: container

%post 
    apk add --no-cache bash build-base bc coreutils
    mkdir /in/
    mkdir /out/

    cd /app

%files from builder
    /app/cadiback/cadiback /app/
    runscripts/measure.sh /app/
    runscripts/cadiback.sh /app/start.sh
%post 
    chmod 0777 measure.sh
    chmod 0777 start.sh

%runscript ["/app/measure.sh"]