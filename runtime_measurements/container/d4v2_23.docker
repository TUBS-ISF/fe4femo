Bootstrap: docker
From:ubuntu:24.04

%post apt-get update && apt-get -y install git libgmp3-dev zlib1g-dev cmake gcc build-essential manpages-dev software-properties-common libboost-all-dev ninja-build wget
%post add-apt-repository ppa:ubuntu-toolchain-r/test
%post apt-get update && apt-get -y install gcc-11 g++-11
%post rm /usr/bin/gcc && rm /usr/bin/g++
%post ln -s /usr/bin/gcc-11 /usr/bin/gcc && ln -s /usr/bin/g++-11 /usr/bin/g++


--cwd /app

%post git clone https://github.com/crillab/d4v2.git
--cwd /app/d4v2
%post git checkout cc730adbbdb59b6e05776fbf2939b2aba53f2b80
--cwd /app/d4v2/3rdParty/
%post wget https://faculty.cc.gatech.edu/~umit/PaToH/patoh-Linux-x86_64-2019-10-01.tar.gz
%post rm -rf patoh/*
%post tar -xf patoh-Linux-x86_64-2019-10-01.tar.gz
%post mv build/Linux-x86_64/* patoh/
--cwd /app/d4v2
%post ./build.sh

From: ubuntu:24.04

%post apt-get update && apt-get -y install libgmp3-dev bc coreutils

%post mkdir /in/
%post mkdir /out/

--cwd /app

%files --from=builder /app/d4v2/build/d4 /app/
%files runscripts/measure.sh /app/
%post chmod 0777 measure.sh

%files runscripts/d4v2_23.sh /app/start.sh
%post chmod 0777 start.sh

%runscript ["/app/measure.sh"]
