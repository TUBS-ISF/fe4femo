Bootstrap: docker
From: alpine:3.20.3
Stage: builder

%post
    apk add --no-cache git build-base bash
    mkdir /app
    cd /app
    chmod 0644 /etc/passwd
    git clone https://github.com/arminbiere/kissat.git
    cd /app/kissat
    ./configure && make

Bootstrap: docker
From: alpine:3.20.3
Stage: final

%post
    apk add --no-cache bash bc coreutils bash

    mkdir /in
    mkdir /out
    mkdir -p /app
    cd /app

%files from builder
    /app/kissat/build/kissat /app/

%files
    runscripts/measure.sh /app/measure.sh
    runscripts/kissat.sh /app/start.sh

%post
    chmod +x measure.sh
    chmod +x start.sh

%runscript
    cd /app
    exec /bin/bash /app/measure.sh "$@"

