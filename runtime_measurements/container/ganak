Bootstrap: docker
From: alpine:3.20.3
Stage: builder

%post
    apk add --no-cache git build-base bash wget gzip tar
    mkdir /app/
    cd /app
    wget https://github.com/meelgroup/ganak/releases/download/release%2Fv2.6.2/ganak-v2.6.2-linux-amd64.tar.gz    
    tar --no-same-owner -xvzf ganak-v2.6.2-linux-amd64.tar.gz

Bootstrap: docker
From: alpine:3.20.3
Stage: final

%post
    apk add --no-cache bash bc coreutils
    mkdir /in/
    mkdir /out/

    cd /app

%files from builder
    /app/ganak /app/
%post
    chmod 0777 ganak

%files
    runscripts/measure.sh /app/
    runscripts/ganak.sh /app/start.sh

%post
    chmod 0777 measure.sh
    chmod 0777 start.sh

%runscript
    exec ./app/measure.sh

