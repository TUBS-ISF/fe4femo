Bootstrap: docker
From: alpine:3.20.3
%post apk add --no-cache git build-base bash wget

--cwd /app
%post wget http://www.msoos.org/private/approxmc-17-oct-2024-linux64

From: alpine:3.20.3

%post apk add --no-cache bash bc coreutils

%post mkdir /in/
%post mkdir /out/

--cwd /app

%files --from=builder /app/approxmc-17-oct-2024-linux64 /app/approxmc
%post chmod 0777 approxmc
%files runscripts/measure.sh /app/
%post chmod 0777 measure.sh
%files runscripts/approxmc.sh /app/start.sh
%post chmod 0777 start.sh
--cwd /app

%runscript ["/app/measure.sh"]
