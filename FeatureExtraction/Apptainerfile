Bootstrap: docker
From: ubuntu:jammy-20240911.1
Stage: satzilla

%files
    external/revisiting_satzilla/SAT-features-competition2024/ /app/external/revisiting_satzilla/SAT-features-competition2024/

%post
    mkdir /app/
    cd /app
    apt-get update && apt-get -y install cmake gcc build-essential software-properties-common zlib1g-dev &&\
    add-apt-repository ppa:ubuntu-toolchain-r/test &&\
    apt-get update && apt-get -y install gcc-11 g++-11 &&\
    rm /usr/bin/gcc && rm /usr/bin/g++ &&\
    ln -s /usr/bin/gcc-11 /usr/bin/gcc && ln -s /usr/bin/g++-11 /usr/bin/g++

    cd /app/external/revisiting_satzilla/SAT-features-competition2024/
    make

